{
  "name": "FDE Job Orchestrator",
  "description": "Streamlit dashboard for monitoring FDE-Feed cron jobs with SQLite backend",
  "repository": "https://github.com/feelgood4everai/fde-orchestrator",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "streamlit run app.py --server.port ${PORT} --server.address 0.0.0.0",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
